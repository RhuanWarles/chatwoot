# Copie para .env. Valores abaixo são placeholders, não credenciais funcionais.
COMPOSE_PROJECT_NAME=chatwoot-crm
CHATWOOT_IMAGE=chatwoot-crm:local
FRONTEND_URL=http://localhost:3000
SECRET_KEY_BASE=SUBSTITUA_POR_SEGREDO_GERADO
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=SUBSTITUA_POR_SEGREDO_GERADO
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=SUBSTITUA_POR_SEGREDO_GERADO
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=SUBSTITUA_POR_SEGREDO_GERADO
POSTGRES_PASSWORD=SUBSTITUA_POR_SEGREDO_GERADO
REDIS_PASSWORD=SUBSTITUA_POR_SEGREDO_GERADO
ENABLE_ACCOUNT_SIGNUP=true
DEFAULT_LOCALE=pt_BR
MAILER_SENDER_EMAIL=Chatwoot <atendimento@example.com>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer
# Evolution opcional: habilitada com --profile evolution
EVOLUTION_IMAGE=evoapicloud/evolution-api:v2.3.7
EVOLUTION_SERVER_URL=http://evolution:8080
EVOLUTION_API_KEY=SUBSTITUA_POR_SEGREDO_GERADO
EVOLUTION_POSTGRES_PASSWORD=SUBSTITUA_POR_SEGREDO_GERADO
EVOLUTION_REDIS_PASSWORD=SUBSTITUA_POR_SEGREDO_GERADO
