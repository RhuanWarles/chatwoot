# Portainer: declare these variables in the Stack environment. No env_file needed.
CHATWOOT_IMAGE=ghcr.io/rhuanwarles/chatwoot:v1.1.0
FRONTEND_URL=https://atendimento.example.com
SECRET_KEY_BASE=REPLACE_WITH_GENERATED_SECRET
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=REPLACE_WITH_GENERATED_KEY
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=REPLACE_WITH_GENERATED_KEY
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=REPLACE_WITH_GENERATED_SALT
FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=false
DEFAULT_LOCALE=pt_BR
# Bundled stack uses these defaults; app-only stack needs reachable hostnames.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
# Do not define DATABASE_URL as an empty string. Use POSTGRES_* by default.
# A non-empty DATABASE_URL requires explicitly adding it to stack.yaml environment.
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
ACTIVE_STORAGE_SERVICE=local
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
MAILER_SENDER_EMAIL=Atendimento <atendimento@example.com>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional group participants/mentions integration; configure URL and key together.
# Accessible from web/worker; e.g. https://evolution.example.com or Docker DNS.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Fallback only. Prefer configuring the instance name separately for each inbox.
EVOLUTION_INSTANCE_NAME=
# Public bind only behind appropriate firewall/proxy. Container proxy: use web:3000.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
STORAGE_VOLUME=chatwoot_crm_storage
POSTGRES_VOLUME=chatwoot_crm_postgres
REDIS_VOLUME=chatwoot_crm_redis
