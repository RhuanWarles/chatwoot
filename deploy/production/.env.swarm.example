# Docker Swarm / Portainer environment for stack-swarm.bundled.yaml
#
# In Portainer, add these entries in the Stack environment instead of
# uploading a production .env file with secrets.
# Keep the same encryption keys and database credentials when migrating an
# existing Chatwoot installation.

CHATWOOT_IMAGE=ghcr.io/rhuanwarles/chatwoot:v1.1.1

# Public Chatwoot URL, including the scheme.
FRONTEND_URL=https://atendimento.example.com
FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=false
DEFAULT_LOCALE=pt_BR

# Rails and Active Record encryption secrets.
SECRET_KEY_BASE=REPLACE_WITH_GENERATED_SECRET
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=REPLACE_WITH_GENERATED_KEY
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=REPLACE_WITH_GENERATED_KEY
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=REPLACE_WITH_GENERATED_SALT

# PostgreSQL service and credentials.
# The database service name is fixed as "postgres" in the Swarm stack.
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD

# Redis service and credentials.
# REDIS_URL is fixed as redis://redis:6379 in the Swarm stack.
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD

# Persistent local volume names. Docker creates them automatically when they
# do not exist. For an existing installation, change them to the exact names
# already used by that installation; for a new installation, leave the defaults.
STORAGE_VOLUME=chatwoot_crm_storage
POSTGRES_VOLUME=chatwoot_crm_postgres
REDIS_VOLUME=chatwoot_crm_redis

# Storage. For S3, change ACTIVE_STORAGE_SERVICE and fill the AWS variables.
ACTIVE_STORAGE_SERVICE=local
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Published host port. Swarm publishes this in host mode on the labeled node.
WEB_PORT=3000

# E-mail.
MAILER_SENDER_EMAIL=Atendimento <atendimento@example.com>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer

# Google OAuth, if enabled for this installation.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Evolution API is external to this Stack.
# EVOLUTION_API_URL must be reachable from the web and worker services.
EVOLUTION_API_URL=https://evolution.example.com
EVOLUTION_API_KEY=REPLACE_WITH_EVOLUTION_API_KEY
# Fallback only; configure the instance name on the API inbox when possible.
EVOLUTION_INSTANCE_NAME=
