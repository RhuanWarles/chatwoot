<% content_for(:title) { t('super_admin.saas_usage.title', account: @saas_account.name) } %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title"><%= content_for(:title) %></h1>
  <%= link_to t('super_admin.saas_usage.back_to_account'), super_admin_account_path(@saas_account), class: 'button' %>
</header>

<section class="main-content__body">
  <p class="mb-6 text-sm text-n-slate-11"><%= t('super_admin.saas_usage.description') %></p>

  <section class="mb-6 rounded-md border border-n-weak p-5">
    <h2 class="text-lg font-medium"><%= t('super_admin.saas_usage.features.title') %></h2>
    <div class="mt-4 grid gap-6 md:grid-cols-2">
      <% %w[text voice].each do |feature| %>
        <% enabled = @saas_account.feature_enabled?("#{feature}_ai") %>
        <%= form_with url: saas_features_super_admin_account_path(@saas_account), method: :post do |form| %>
          <%= form.hidden_field :feature, value: feature %>
          <%= form.label :enabled, t("super_admin.saas_usage.resources.#{feature}"), for: "#{feature}_ai_enabled", class: 'block font-medium' %>
          <p class="my-2 text-sm text-n-slate-11"><%= t("super_admin.saas_usage.features.#{feature}_description") %></p>
          <div class="flex items-center gap-3">
            <%= form.check_box :enabled, { id: "#{feature}_ai_enabled", checked: enabled, role: 'switch', class: 'h-5 w-5' }, 'true', 'false' %>
            <span><%= t("super_admin.saas_usage.features.#{enabled ? 'enabled' : 'disabled'}") %></span>
            <%= form.submit t('super_admin.saas_usage.features.save'), class: 'button' %>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>

  <div class="grid gap-6 md:grid-cols-2">
    <% { 'text_credits' => 'text', 'voice_seconds' => 'voice' }.each do |resource, label| %>
      <% wallet = @saas_wallets.fetch(resource) %>
      <% divisor = resource == 'voice_seconds' ? 60.0 : 1 %>
      <% total = number_with_precision(wallet.balance_units / divisor, precision: 2, strip_insignificant_zeros: true) %>
      <% reserved = number_with_precision(wallet.public_data[:reserved_units] / divisor, precision: 2, strip_insignificant_zeros: true) %>
      <% available = number_with_precision(wallet.public_data[:available_units] / divisor, precision: 2, strip_insignificant_zeros: true) %>
      <article class="rounded-md border border-n-weak p-5">
        <h2 class="text-lg font-medium"><%= t("super_admin.saas_usage.resources.#{label}") %></h2>
        <p class="text-sm text-n-slate-11"><%= t("super_admin.saas_usage.features.#{@saas_account.feature_enabled?("#{label}_ai") ? 'enabled' : 'disabled'}") %></p>
        <dl class="mt-4 space-y-2 text-sm">
          <div class="flex justify-between">
            <dt><%= t('super_admin.saas_usage.total') %></dt>
            <dd><%= total %> <%= t("super_admin.saas_usage.units.#{label}") %></dd>
          </div>
          <div class="flex justify-between">
            <dt><%= t('super_admin.saas_usage.reserved') %></dt>
            <dd><%= reserved %> <%= t("super_admin.saas_usage.units.#{label}") %></dd>
          </div>
          <div class="flex justify-between font-medium">
            <dt><%= t('super_admin.saas_usage.available') %></dt>
            <dd><%= available %> <%= t("super_admin.saas_usage.units.#{label}") %></dd>
          </div>
        </dl>

        <%= form_with url: saas_usage_adjust_super_admin_account_path(@saas_account), method: :post, class: 'mt-6 space-y-3' do |form| %>
          <%= form.hidden_field :resource, value: resource %>
          <%= form.hidden_field :idempotency_key, value: SecureRandom.uuid %>
          <div>
            <%= form.label :amount, t("super_admin.saas_usage.amount.#{label}"), for: "#{resource}_amount", class: 'block text-sm font-medium' %>
            <%= form.number_field :amount, id: "#{resource}_amount", step: 1, required: true, class: 'mt-1 w-full' %>
            <p class="mt-1 text-sm text-n-slate-11"><%= t('super_admin.saas_usage.signed_amount_help') %></p>
          </div>
          <div>
            <%= form.label :reason, t('super_admin.saas_usage.reason'), for: "#{resource}_reason", class: 'block text-sm font-medium' %>
            <%= form.text_area :reason, id: "#{resource}_reason", required: true, maxlength: 500, rows: 2, class: 'mt-1 w-full' %>
          </div>
          <%= form.submit t('super_admin.saas_usage.submit'), class: 'button' %>
        <% end %>
      </article>
    <% end %>
  </div>

  <section class="mt-8">
    <h2 class="text-lg font-medium"><%= t('super_admin.saas_usage.history') %></h2>
    <% if @saas_usage_records.empty? %>
      <p class="mt-3 text-sm text-n-slate-11"><%= t('super_admin.saas_usage.no_history') %></p>
    <% else %>
      <div class="mt-3 overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-n-weak">
              <th class="p-2"><%= t('super_admin.saas_usage.date') %></th>
              <th class="p-2"><%= t('super_admin.saas_usage.resource') %></th>
              <th class="p-2"><%= t('super_admin.saas_usage.change') %></th>
              <th class="p-2"><%= t('super_admin.saas_usage.status') %></th>
              <th class="p-2"><%= t('super_admin.saas_usage.reason') %></th>
              <th class="p-2"><%= t('super_admin.saas_usage.actor') %></th>
            </tr>
          </thead>
          <tbody>
            <% @saas_usage_records.each do |record| %>
              <% metadata = record.metadata || {} %>
              <% delta = metadata['delta_units'] %>
              <% delta = record.reserved_units if delta.nil? && record.status == 'reserved' %>
              <% delta = record.units if delta.nil? && record.kind == 'credit' %>
              <% delta = -record.units if delta.nil? && record.kind == 'adjustment' %>
              <% delta = 0 if delta.nil? %>
              <% delta /= 60.0 if record.wallet.resource == 'voice_seconds' %>
              <tr class="border-b border-n-weak">
                <td class="p-2"><%= l(record.created_at, format: :short) %></td>
                <td class="p-2"><%= t("super_admin.saas_usage.resources.#{record.wallet.resource == 'text_credits' ? 'text' : 'voice'}") %></td>
                <td class="p-2"><%= delta.positive? ? '+' : '' %><%= delta %></td>
                <td class="p-2"><%= record.status %></td>
                <td class="p-2"><%= metadata['reason'].presence || record.kind %></td>
                <td class="p-2"><%= metadata['actor_email'].presence || t('super_admin.saas_usage.system') %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
  <% history = @saas_account.internal_attributes.fetch('ai_feature_history', []) %>
  <% if history.any? %>
    <section class="mt-8">
      <h2 class="text-lg font-medium"><%= t('super_admin.saas_usage.features.history') %></h2>
      <ul class="mt-3 space-y-2 text-sm">
        <% history.reverse_each do |event| %>
          <li>
            <%= l(Time.iso8601(event.fetch('at')), format: :short) %> ·
            <%= event.fetch('actor_email') %> ·
            <%= t("super_admin.saas_usage.resources.#{event.fetch('feature')}") %>:
            <%= t("super_admin.saas_usage.features.#{event.fetch('previous') ? 'enabled' : 'disabled'}") %> →
            <%= t("super_admin.saas_usage.features.#{event.fetch('enabled') ? 'enabled' : 'disabled'}") %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</section>
